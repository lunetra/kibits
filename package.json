{
  "name": "kibitz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension for taketaketake.com: Game Review commentary translated into Persian or German with Gemini, plus calm dark board themes.",
  "scripts": {
    "dev": "wxt",
    "themes": "tsx scripts/build-themes.ts",
    "prebuild": "tsx scripts/build-themes.ts",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "tsx scripts/build-themes.ts && wxt prepare",
    "icons": "tsx scripts/build-icons.ts",
    "preview:boards": "tsx scripts/preview-boards.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT"
}
